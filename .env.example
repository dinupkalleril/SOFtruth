# Copy to .env and fill in. .env is gitignored and must stay that way: this repo
# becomes public before the first vendor record, and a key committed here could
# not be unpublished, only rotated.

# ---------------------------------------------------------------------------
# Inbox domain
# ---------------------------------------------------------------------------
# Where test messages are addressed. A subdomain, never the apex: keeping MX
# records off softruth.com leaves the apex free for the site and any future mail.
# This subdomain is registered as an inbound domain with the receiving service.
SOFTRUTH_INBOX_DOMAIN=inbox.softruth.com

# Where bounce probes go. Needs a NULL MX record (`. 0 MX 0 "."`) so every
# provider treats it as a hard bounce. A SIBLING of the inbox domain, and it must
# NEVER be registered with the receiving service: if mail to it succeeds, the
# bounce assertion silently stops testing anything.
SOFTRUTH_BOUNCE_DOMAIN=bounce.softruth.com

# The domain in effect is recorded in every result, because a seed alone does not
# determine the addresses: it fixes the local-parts and the domain completes
# them. That way records made against a test domain still replay correctly after
# a move to the real one.

# ---------------------------------------------------------------------------
# Mailbox
# ---------------------------------------------------------------------------
# Lets the agent read the verification email a product sends during signup.
# Without it the agent usually cannot finish signing up, and the failure would be
# ours rather than the product's.
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# The agent's reasoning
# ---------------------------------------------------------------------------
# Either provider works. Whichever runs is recorded in the account as its byline,
# because two models will not write the same account of the same product and a
# reader deserves to know whose experience they are reading.
#
# With no explicit provider, whichever key is present is used.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Force one, and optionally a specific model.
# SOFTRUTH_AGENT_PROVIDER=openai
# SOFTRUTH_AGENT_MODEL=gpt-5

# ---------------------------------------------------------------------------
# Local development only
# ---------------------------------------------------------------------------
# Set to "memory" to run the suite against an in-process fake inbox. Useful for
# smoke tests; never produces a publishable record, because nothing actually
# sends mail and a PASS would mean nothing.
# SOFTRUTH_INBOX=memory
