# Copy to .env and fill in. .env is gitignored and must stay that way: this repo
# becomes public before the first vendor record, and a key committed here could
# not be unpublished, only rotated.

# ---------------------------------------------------------------------------
# Inbox domain
# ---------------------------------------------------------------------------
# Where test messages are addressed. Use a SUBDOMAIN, never the apex of a domain
# that already receives mail: adding MX records at the apex would break existing
# email. A domain you already own works fine for pre-launch testing.
SOFTRUTH_INBOX_DOMAIN=sft-inbox.mayin.me

# Where bounce probes go. Needs a NULL MX record (`. 0 MX 0 "."`) so every
# provider treats it as a hard bounce. Defaults to bounce.<inbox domain>.
SOFTRUTH_BOUNCE_DOMAIN=bounce.sft-inbox.mayin.me

# The domain in effect is recorded in every result, because a seed alone does not
# determine the addresses: it fixes the local-parts and the domain completes
# them. That way records made against a test domain still replay correctly after
# a move to the real one.

# ---------------------------------------------------------------------------
# Reference implementation (vendor zero) — the thing being tested
# ---------------------------------------------------------------------------
# Lets the reference implementation actually send mail, so it behaves like a real
# provider rather than a stub. Only the reference impl uses this; SOFtruth itself
# never talks to Resend.
RESEND_API_KEY=

# Verified sending domain on the Resend account.
RESEND_FROM=probe@mayin.me

# ---------------------------------------------------------------------------
# Vendor tokens — how SOFtruth authenticates INTO a provider
# ---------------------------------------------------------------------------
# One per vendor, named SOFTRUTH_TOKEN_<SLUG> in upper snake case. This is the
# token the provider issues to SOFtruth, which is the opposite direction from
# RESEND_API_KEY above. They are different secrets with different jobs.
SOFTRUTH_TOKEN_REFERENCE=

# ---------------------------------------------------------------------------
# Local development only
# ---------------------------------------------------------------------------
# Set to "memory" to run the suite against an in-process fake inbox. Useful for
# smoke tests; never produces a publishable record, because nothing actually
# sends mail and a PASS would mean nothing.
# SOFTRUTH_INBOX=memory
